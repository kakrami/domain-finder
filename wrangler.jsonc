{
  "name": "domain-finder",
  "main": "worker.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "keep_vars": true,
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html"
      ],
      "fallthrough": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CATALOG",
        "class_name": "DomainCatalog"
      }
    ]
  },
  "exports": {
    "DomainCatalog": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
